{
	"name": "ape-compta",
	"version": "0.1.0",
	"description": "Outil libre de comptabilité analytique pour associations de parents d'élèves",
	"license": "AGPL-3.0-only",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": ">=26.13.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"bin": {
		"ape": "./build/cli/ape.js"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && vite build --config vite.cli.config.ts",
		"preview": "node build/index.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"jetons": "node scripts/generer-jetons.ts",
		"test": "vitest run",
		"test:couverture": "vitest run --coverage --project domaine",
		"test:e2e": "pnpm build && playwright test",
		"test:e2e:webkit": "pnpm build && WEBKIT=1 playwright test --project=webkit --timeout=45000",
		"test:prive": "node scripts/test-prive.ts",
		"test:cycle": "node tests/cycle/cycle.ts",
		"test:cycle:montee": "node tests/cycle/montee.ts",
		"test:machine-vierge": "node tests/cycle/machine-vierge.ts"
	},
	"dependencies": {
		"@fontsource-variable/fraunces": "5.3.0",
		"@fontsource-variable/source-sans-3": "5.3.1",
		"@internationalized/date": "3.12.4",
		"@lucide/svelte": "1.68.0",
		"@sveltejs/adapter-node": "6.0.1",
		"@sveltejs/kit": "3.1.1",
		"better-sqlite3": "13.0.3",
		"bits-ui": "2.20.5",
		"fflate": "0.8.3",
		"papaparse": "5.7.0",
		"pdfkit": "0.20.2",
		"svelte": "5.57.3",
		"write-excel-file": "4.1.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.64.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "26.6.6",
		"@types/papaparse": "5.5.2",
		"@types/pdfkit": "0.17.7",
		"@vitest/coverage-v8": "5.1.0",
		"eslint": "10.14.0",
		"eslint-plugin-svelte": "3.24.0",
		"fast-check": "4.10.2",
		"globals": "17.14.0",
		"pdfjs-dist": "6.5.438",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte-check": "4.7.8",
		"svelte-eslint-parser": "1.10.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vite": "8.3.5",
		"vitest": "5.1.0"
	}
}
