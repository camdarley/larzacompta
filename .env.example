# À copier en `.env`, jamais commité. Détail dans docs/installation.md.

# Adresse publique de l'instance, sans chemin. Caddy en tire son certificat HTTPS.
ORIGIN=https://compta.exemple.org
TZ=Europe/Paris

# Posés par Caddy : adapter-node en déduit l'origine des requêtes et l'adresse réelle.
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1
# Une Pièce pèse 20 Mio au plus, le reste de la marge couvre l'enveloppe de la requête.
BODY_SIZE_LIMIT=25M

# Obligatoire : chiffre les sauvegardes. Gardez-en une copie HORS du serveur : sans lui, aucune
# sauvegarde ne se relit. Générer avec : openssl rand -base64 32
RESTIC_PASSWORD=
# Obligatoire en pratique : le dépôt de sauvegarde hors du serveur, tout dépôt restic convient.
# Vide, la sauvegarde reste sur ce serveur et l'outil affiche « copie hors du VPS à configurer ».
RESTIC_REPOSITORY=
# Identifiants du dépôt : selon l'hébergeur, voir docs/installation.md.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# 0 désactive la lecture quotidienne de la dernière version publiée.
VERIFIER_VERSION=1

# Image à utiliser une fois le projet publié. Par défaut : construite ici depuis les sources.
# APE_IMAGE=
