# Adresse publique de l'instance, sans chemin.
ORIGIN=https://compta.exemple.org
# Dossier des données : base, fichiers, sauvegardes.
APE_DONNEES=/data
TZ=Europe/Paris
# Posés par Caddy : adapter-node 6 en déduit l'origine des requêtes.
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1
BODY_SIZE_LIMIT=25M
